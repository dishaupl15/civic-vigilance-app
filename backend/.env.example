# REQUIRED: server runtime
NODE_ENV=production
PORT=3000
# Exact HTTPS frontend origins, comma-separated. Do not use * in production.
ALLOWED_ORIGIN=https://app.your-domain.example

# REQUIRED: Supabase Dashboard > Project Settings > API Keys
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# SERVER ONLY. Never add this to frontend/.env or an EXPO_PUBLIC variable.
SUPABASE_SECRET_KEY=sb_secret_your_key
# Legacy projects may use SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# instead. Configure one client key and one server key, never both in frontend.

# OPTIONAL: server-mediated image analysis. Set both values or leave both empty.
# structured request and return the six validated analysis fields.
AI_VISION_ENDPOINT=
AI_VISION_API_KEY=

# OPTIONAL: server-mediated report-text drafting. Configure a separate HTTPS
# endpoint that accepts { task, report, instructions, response_schema } and
# returns the requested JSON object directly. Set both values or leave both empty.
AI_TEXT_ENDPOINT=
AI_TEXT_API_KEY=
